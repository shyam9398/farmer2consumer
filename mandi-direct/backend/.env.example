# ==========================================
# Mandi Direct Backend Environment Configuration
# SIH 2026 Problem Statement 26033
# ==========================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# PostgreSQL Database URL (Supabase Transaction Pooler or Direct Connection)
# Example format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mandi_direct

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://farmer2consumer.vercel.app,https://farmer2consumer-5uxb.vercel.app
