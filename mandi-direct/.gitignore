# ==========================================
# Mandi Direct Monorepo .gitignore
# ==========================================

# Environment variables & secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.env

# Dependencies
node_modules/
.pnp
.pnp.js
vendor/
.venv/
venv/
ENV/

# Build artifacts & distribution
dist/
dist-ssr/
build/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local SQLite databases
*.db
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
@"
node_modules/
**/node_modules/
dist/
**/dist/
.env
.env.local
"@ | Set-Content .gitignore